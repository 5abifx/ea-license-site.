<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release -p:QuantowerBin="C:\Quantower\TradingPlatform\v1.xx.x\bin"
       Output: bin\Release\5ABI Journal.dll -> copy into a folder named "5ABI Journal" under Quantower\Settings\Scripts\Strategies -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>5ABI Journal</AssemblyName>
    <RootNamespace>Journal5ABI</RootNamespace>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <QuantowerBin Condition="'$(QuantowerBin)' == ''">C:\Quantower\TradingPlatform\bin</QuantowerBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerBin)\TradingPlatform.BusinessLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
