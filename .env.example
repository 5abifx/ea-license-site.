# Copy this file to .env and fill it in.
SITE_NAME=5ABI.FX
PORT=3000
# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Admin login created on first start
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-now
# closed = only you create users, approval = users sign up and you approve, open = anyone gets access
SIGNUP_MODE=approval
MAX_ACCOUNTS=10
# Free trial for new sign ups: days of full access (0 = no trial, use SIGNUP_MODE instead)
TRIAL_DAYS=15
# MT5 accounts a trial user may register (each account number gets only one trial)
TRIAL_ACCOUNTS=1
# Price shown to customers, and days added by the admin "Mark as paid" button
PRICE_TEXT=$20/month
PAID_DAYS=30
# Optional link for the Subscribe button (payment page or your Discord invite)
# PAYMENT_URL=https://discord.gg/your-invite
# Optional link for "Contact us" on the FAQ, terms and privacy pages (defaults to PAYMENT_URL)
# CONTACT_URL=https://discord.gg/your-invite
# Set to true once the site runs on https
COOKIE_SECURE=false
# Where the database and EA files are stored (back this folder up)
# DATA_DIR=./data
# Sign in with Google. When both are set, new accounts can only be created with Google
# (stops fake email sign ups for repeat trials). Existing users and the admin can still use their password.
# Authorized redirect URI in Google Cloud: https://YOUR-SITE/auth/google/callback
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# Optional: public address of the site if the redirect URI comes out wrong behind a proxy
# BASE_URL=https://ea-license-site.onrender.com
